<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SKIPPY.MainWindow"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="360"
        Height="300"
        CanResize="False">

    <!-- Fixed-size canvas: pet at bottom-left, bubble floats above/right.
         Window is always 360x220 — the pet (120x120) occupies the bottom-left.
         Extra space is fully transparent; bubble appears there when needed. -->
    <Canvas ClipToBounds="False">
        <!-- Pet sits at bottom-left of the 360x220 window -->
        <Border x:Name="Ball"
                Canvas.Left="240" Canvas.Top="180"
                Width="120" Height="120"
                Background="Transparent"
                PointerPressed="Ball_PointerPressed"
                PointerMoved="Ball_PointerMoved"
                PointerReleased="Ball_PointerReleased">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" />
            </Border.RenderTransform>
            <Image x:Name="BallImage"
                   Width="120" Height="120"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>

        <!-- Bubble overlay — sits in the space above/right of the pet -->
        <Border x:Name="BubbleOverlay"
                Canvas.Left="130" Canvas.Top="40"
                IsVisible="False"
                Background="White"
                CornerRadius="8"
                Padding="10,6"
                Margin="2">
            <TextBlock x:Name="BubbleText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="200" />
        </Border>

        <!-- Countdown label — above the pet -->
        <Border x:Name="CountdownOverlay"
                Canvas.Left="0" Canvas.Top="0"
                IsVisible="False"
                Background="#CC000000"
                CornerRadius="6"
                Padding="8,3"
                Margin="1">
            <TextBlock x:Name="CountdownText"
                       FontSize="11"
                       Foreground="White"
                       TextWrapping="Wrap"
                       MaxWidth="300" />
        </Border>
    </Canvas>

    <Window.ContextMenu>
        <ContextMenu x:Name="MenuControl">
            <MenuItem x:Name="SearchMenuItem" Header="搜索">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="120" Height="22"
                             VerticalAlignment="Center" />
                    <Button Content="🔍" Width="30" Height="22"
                            Click="SearchBtn_Click" Margin="4,0,0,0" />
                </StackPanel>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="CodeMenu" Header="代码模块" />
            <MenuItem x:Name="PortalMenu" Header="传送门" />
            <MenuItem x:Name="BookmarkMenu" Header="📑 收藏夹" />
            <MenuItem x:Name="DeletedMenu" Header="已删除网站" />
            <Separator />
            <MenuItem x:Name="CharCountMenu" Header="字数统计"
                      Click="CharCount_Click" />
            <MenuItem Header="📋 预设管理" Click="PresetManage_Click" />
            <MenuItem Header="⏰ 倒计时" Click="Countdown_Click" />
            <MenuItem x:Name="SkinMenu" Header="皮肤" />
            <Separator />
            <MenuItem Header="🤖 AI 吐槽" Click="AiRoast_Click" />
            <Separator />
            <MenuItem Header="关于" Click="About_Click" />

            <MenuItem Header="退出" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
